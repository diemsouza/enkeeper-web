enum UserStatus {
    active
    suspended
    disabled
}

enum PlanCode {
    trial
    pro
}

enum PlanStatus {
    active
    canceled
    past_due
    expired
}

model User {
    id       String  @id @default(ulid()) @map("id")
    name     String? @map("name")
    // sempre em minúsculas; identidade da conta no login com Google
    // (CHECK users_email_lowercase_check, na migration users_phone_or_email)
    email    String? @unique @map("email")
    // telefone no formato de normalizePhoneToWaId; identidade da conta no login e no WhatsApp
    // phone ou email, pelo menos um (CHECK users_phone_or_email_check)
    phone    String? @unique @map("phone")
    imageUrl String? @map("image_url")

    // plano - atualizado pelo webhook Stripe ou manualmente no MVP
    planCode            PlanCode   @default(trial) @map("plan_code")
    planCodeUpdatedAt   DateTime   @default(now()) @map("plan_code_updated_at")
    planStatus          PlanStatus @default(active) @map("plan_status")
    planStatusUpdatedAt DateTime   @default(now()) @map("plan_status_updated_at")
    planExpiresAt       DateTime?  @map("plan_expires_at")

    level           Level?     @map("level")
    pendingIntent   String?    @map("pending_intent")
    pendingIntentAt DateTime?  @map("pending_intent_at")
    metadata        Json?      @map("metadata")
    checkoutData    Json?      @map("checkout_data")
    onboardedAt     DateTime?  @map("onboarded_at")

    // preferência de lembrete diário de prática; horário é hora de parede
    // ("HH:mm"), só faz sentido combinado com o timezone do usuário
    dailyReminderEnabled Boolean @default(true) @map("daily_reminder_enabled")
    dailyReminderTime    String  @default("20:00") @map("daily_reminder_time")
    timezone             String  @default("America/Sao_Paulo") @map("timezone")
    // snapshot da origem do usuário, gravado só na criação e nunca reescrito depois
    source     String? @map("source")
    sourceData Json?   @map("source_data")
    // lastRequestAt não representa a última mensagem recebida; representa a
    // última mensagem aceita para processamento. Mensagens bloqueadas pelo lock
    // nunca atualizam este campo.
    lastRequestAt  DateTime? @map("last_request_at")
    lastMessageId  String?   @map("last_message_id")
    lastResponseAt DateTime? @map("last_response_at")
    status       UserStatus @default(active) @map("status")
    statusUpdatedAt DateTime @default(now()) @map("status_updated_at")
    createdAt   DateTime   @default(now()) @map("created_at")
    updatedAt   DateTime   @updatedAt @map("updated_at")
    deletedAt   DateTime?  @map("deleted_at")

    docs          Doc[]
    activities    Activity[]
    weeklyReports WeeklyReport[]
    llmUsages     LlmUsage[]
    messages      Message[]
    dailyUsages   DailyUsage[]
    llmLogs       LlmLog[]
    docItems      DocItem[]
    notifications Notification[]
    questions     Question[]
    medias        Media[]
    subscriptions Subscription[]

    @@index([pendingIntent, pendingIntentAt])
    @@index([dailyReminderEnabled, dailyReminderTime])
    @@map("users")
}

// pagamento; o acesso continua no User (planCode, planStatus, planExpiresAt)
model Subscription {
    id                    String    @id @default(ulid()) @map("id")
    userId                String    @map("user_id")
    paymentProvider       String    @map("payment_provider") // stripe ou origem do pagamento recebido por fora
    paymentMethod         String?   @map("payment_method") // ex: card_credit, card_debit, pix
    paymentCustomerId     String?   @map("payment_customer_id")
    paymentSubscriptionId String?   @unique @map("payment_subscription_id")
    interval              String    @map("interval") // monthly | yearly
    amount                Int       @map("amount") // centavos
    currency              String    @default("BRL") @map("currency")
    status                String    @map("status")
    currentPeriodEnd      DateTime? @map("current_period_end")
    cancelAtPeriodEnd     Boolean   @default(false) @map("cancel_at_period_end")
    canceledAt            DateTime? @map("canceled_at")
    createdAt             DateTime  @default(now()) @map("created_at")
    updatedAt             DateTime  @updatedAt @map("updated_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, createdAt])
    @@map("subscriptions")
}

model DailyUsage {
    id                String   @id @default(ulid()) @map("id")
    userId            String   @map("user_id")
    date              DateTime @map("date") @db.Date
    docCount          Int      @default(0) @map("doc_count")
    activityCount     Int      @default(0) @map("activity_count")
    practiceCount     Int      @default(0) @map("practice_count")
    intensiveCount    Int      @default(0) @map("intensive_count")
    userMessageCount  Int      @default(0) @map("user_message_count")
    agentMessageCount Int      @default(0) @map("agent_message_count")
    messagesCount     Int      @default(0) @map("messages_count")
    createdAt         DateTime @default(now()) @map("created_at")
    updatedAt         DateTime @updatedAt @map("updated_at")

    user User @relation(fields: [userId], references: [id])

    @@unique([userId, date])
    @@map("daily_usages")
}

model OtpCode {
    id           String    @id @default(ulid()) @map("id")
    phone        String    @map("phone")
    codeHash     String    @map("code_hash")
    attemptsUsed Int       @default(0) @map("attempts_used")
    expiresAt    DateTime  @map("expires_at")
    consumedAt   DateTime? @map("consumed_at")
    createdAt    DateTime  @default(now()) @map("created_at")

    @@index([phone, createdAt])
    @@map("otp_codes")
}
