<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{title}}</title>
  </head>
  <body
    style="margin:0; padding:24px; background-color:#f9f9f9; font-family:Arial, sans-serif;"
  >
    <table
      role="presentation"
      cellspacing="0"
      cellpadding="0"
      border="0"
      width="100%"
    >
      <tr>
        <td align="center">
          <table
            role="presentation"
            cellspacing="0"
            cellpadding="0"
            border="0"
            width="100%"
            style="max-width:600px; background:#ffffff; border-radius:8px; padding:32px;"
          >
            <tr>
              <td>
                <h2 style="color:#000; margin-top:0;">{{title}}</h2>

                {{#if message}}
                  <p
                    style="font-size:16px; color:#555; line-height:1.5; margin-bottom:16px; white-space:pre-wrap;"
                  >{{message}}</p>
                {{/if}}

                {{#if fields}}
                  <table
                    role="presentation"
                    cellspacing="0"
                    cellpadding="8"
                    border="0"
                    width="100%"
                    style="margin-top:12px; border:1px solid #e5e7eb; border-radius:8px;"
                  >
                    {{#each fields}}
                      <tr>
                        <td
                          style="font-weight:bold; border-bottom:1px solid #e5e7eb; width:40%;"
                        >{{label}}</td>
                        <td
                          style="border-bottom:1px solid #e5e7eb;"
                        >{{value}}</td>
                      </tr>
                    {{/each}}
                  </table>
                {{/if}}

                {{#if url}}
                  <table
                    role="presentation"
                    cellspacing="0"
                    cellpadding="0"
                    border="0"
                    style="margin-top:24px;"
                  >
                    <tr>
                      <td
                        align="center"
                        bgcolor="#000000"
                        style="border-radius:4px;"
                      >
                        <a
                          href="{{url}}"
                          style="display:inline-block; padding:12px 24px; color:#ffffff; text-decoration:none; font-weight:bold;"
                        >
                          Abrir
                        </a>
                      </td>
                    </tr>
                  </table>
                {{/if}}

                <hr
                  style="border:none; border-top:1px solid #e5e7eb; margin:32px 0;"
                />

                <p style="font-size:12px; color:#9ca3af; text-align:center;">
                  Notificação interna enviada pela plataforma
                  <strong>Fluizer</strong>.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
